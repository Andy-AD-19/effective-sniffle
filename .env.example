# FMOH Inventory Management System - Global Environment Variables (Template)
# Copy to .env or configure in Cloudflare Pages Dashboard

# --- Frontend (Cloudflare Pages) ---
VITE_API_BASE_URL=/api

# --- Backend (API Server) ---
PORT=3001
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
DATABASE_URL=file:./inventory.db
CORS_ORIGIN=*
